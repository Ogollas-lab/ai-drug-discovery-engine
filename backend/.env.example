# =============================================================================
# Vitalis AI Drug Engine — Backend Environment
# Intelligence layer: Pawanax AI (NVIDIA NIM + LangChain)
# Copy to backend/.env — never commit real secrets
# =============================================================================

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:8080
FRONTEND_URL=http://localhost:8080

# --- MongoDB (legacy auth / subscription) ---
MONGODB_URI=mongodb://localhost:27017/vitalis-ai

# --- Neon Postgres (engine persistence: runs, provenance, HITL) ---
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Redis (optional — in-process queue if unset) ---
REDIS_URL=redis://localhost:6379

# --- Google Gemini (fallback reasoning when NVIDIA unavailable) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- NVIDIA NIM (Pawanax AI primary provider) ---
# Get key: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_REASONING_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_CHAT_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_MOLMIM_URL=https://health.api.nvidia.com/v1/biology/nvidia/molmim/generate

# --- Engine behaviour ---
ENGINE_REQUIRE_AUTH=false
DEFAULT_MODEL_PROVIDER=nvidia

# --- Stripe (optional billing) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- JWT ---
JWT_SECRET=change-me-in-production
