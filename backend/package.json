{
  "name": "pawanax-ai-backend",
  "version": "3.0.0",
  "description": "Pawanax AI — In-Silico Drug Discovery Engine Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "NODE_ENV=test jest --testPathIgnorePatterns=auth-subscription",
    "test:all": "NODE_ENV=test jest",
    "test:engine": "NODE_ENV=test jest test/engine.test.js test/engine-api.test.js test/engine-hitl.test.js test/engine-scientific.test.js --forceExit",
    "test:integration": "NODE_ENV=test jest test/engine-nvidia.integration.test.js --forceExit --runInBand",
    "db:migrate": "node scripts/migrate.js",
    "seed": "node src/scripts/seedDatabase.js"
  },
  "keywords": [
    "drug-discovery",
    "molecular-properties",
    "binding-affinity",
    "ai-predictions"
  ],
  "author": "Pawanax AI",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@google/generative-ai": "^0.3.0",
    "@langchain/core": "^1.2.1",
    "@langchain/langgraph": "^1.4.5",
    "@langchain/openai": "^1.5.3",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.79.1",
    "cors": "^2.8.5",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^1.5.2",
    "lodash": "^4.17.21",
    "mongoose": "^8.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.7",
    "pg": "^8.22.0",
    "stripe": "^13.10.0",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
